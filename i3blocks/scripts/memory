#!/bin/bash

source "$HOME/.config/i3blocks/scripts/utils/utils"
source "$HOME/.config/i3blocks/scripts/utils/expandable"

EXPAND_STATE_FILE="$EXPAND_STATE_DIR/memory"

SIGNAL=5

expand_state_on_click "$EXPAND_STATE_FILE" "$SIGNAL"

read -r mem swap < <(
    free | awk '
        /Mem:/ {mem = sprintf("%.0f", $3 / $2 * 100)}
        /Swap:/ {swap = ($2 > 0) ? sprintf("%.0f", $3 / $2 * 100) : 0}
        END {print mem, swap}
    '
)

if expand_state_is_active "$EXPAND_STATE_FILE"; then
    printf "<b>RAM</b> %s %s%% <b>SWAP</b> %s %s%%\n" \
        "$(ramp "$mem")" "$mem" \
        "$(ramp "$swap")" "$swap"
else
    printf "<b>RAM</b> %s <b>SWAP</b> %s\n" \
        "$(ramp "$mem")" \
        "$(ramp "$swap")"
fi