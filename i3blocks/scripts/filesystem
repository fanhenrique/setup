#!/bin/bash

source "$HOME/.config/i3blocks/scripts/utils/utils"
source "$HOME/.config/i3blocks/scripts/utils/expandable"

STATE_FILE="/tmp/i3blocks-filesystem"
SIGNAL=6

PARTITIONS=(
    "/"
    "/home"
)

get_fs_info() {
    df -hP "$1" 2>/dev/null | awk 'NR==2 {
        gsub("%","",$5)
        print $3, $2, $5
    }'
}

case "$BLOCK_BUTTON" in
    1) expandable_start "$STATE_FILE" "$SIGNAL";;
    3) expandable_toggle "$STATE_FILE";;
esac

for partition in "${PARTITIONS[@]}"; do
    read -r used size percent <<<"$(get_fs_info "$partition")"

    if expandable "$STATE_FILE"; then
        printf "<b>%s</b> %s %s%% (%s/%s) " "$partition" "$(ramp "$percent")" "$percent" "$used" "$size"
    else
        printf "<b>%s</b> %s %s" "$partition" "$(ramp "$percent")"
    fi
done
