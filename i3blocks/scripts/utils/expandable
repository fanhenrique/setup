#!/bin/bash

EXPANSION_TIME=5
EXPANSION_TIME_LIMIT=60

expandable_toggle() {
    local state_file="$1"

    if expandable "$state_file"; then
        rm -f "$state_file"
    else
        printf "perm\n" > "$state_file"
    fi
}

expandable_start() {
    local state_file="$1"
    local signal="$2"
    local expand_time="${3:-$EXPANSION_TIME}"

    if expandable "$state_file"; then
        rm -f "$state_file"
        return
    fi

    local expires=$(( $(date +%s) + expand_time ))

    printf "%s\n" "$expires" > "$state_file"

    (
        sleep "$expand_time"

        [[ -f "$state_file" ]] || exit 0

        local state
        read -r state < "$state_file"

        # Outro clique alterou o estado.
        [[ "$state" == "$expires" ]] || exit 0

        rm -f "$state_file"

        pkill -RTMIN+"$signal" i3blocks >/dev/null 2>&1
    ) >/dev/null 2>&1 &
}

expandable() {
    local state_file="$1"

    [[ -f "$state_file" ]] || return 1

    local state
    read -r state < "$state_file"

    [[ "$state" == "perm" ]] && return 0

    if (( $(date +%s) < state )); then
        return 0
    fi

    rm -f "$state_file"
    return 1
}