#!/usr/bin/env bash

STEP=5%
SIGNAL=10

refresh() {
    pkill -RTMIN+$SIGNAL i3blocks >/dev/null 2>&1
}

toggle_sink() {
    mapfile -t SINKS < <(pactl list short sinks | awk '{print $2}')

    (( ${#SINKS[@]} <= 1 )) && return

    CURRENT=$(pactl get-default-sink)

    NEXT=0
    for i in "${!SINKS[@]}"; do
        if [[ "${SINKS[$i]}" == "$CURRENT" ]]; then
            NEXT=$(( (i + 1) % ${#SINKS[@]} ))
            break
        fi
    done

    NEW="${SINKS[$NEXT]}"

    pactl set-default-sink "$NEW"

    # Move todos os streams para o novo sink
    while read -r ID _; do
        pactl move-sink-input "$ID" "$NEW"
    done < <(pactl list short sink-inputs)
}

get_sink_description() {
    local sink="$1"

    pactl list sinks |
    awk -v sink="$sink" '
        $1=="Name:" && $2==sink {found=1}
        found && $1=="Description:" {
            $1=""
            sub(/^ /,"")
            print
            exit
        }
    '
}

short_name() {
    local name="$1"

    case "$name" in
        *"Built-in"*)
            echo "Interno"
            ;;
        *"USB"*)
            echo "USB"
            ;;
        *"HDMI"*|*"DisplayPort"*)
            echo "HDMI"
            ;;
        *)
            # Retorna apenas a primeira palavra
            echo "$name" | awk '{print $1}'
            ;;
    esac
}

case "$BLOCK_BUTTON" in
    1)
        pactl set-sink-mute @DEFAULT_SINK@ toggle
        refresh
        ;;
    3)
        toggle_sink

        refresh
        ;;
    4)
        pactl set-sink-volume @DEFAULT_SINK@ +"$STEP"
        pactl set-sink-mute @DEFAULT_SINK@ 0
        refresh
        ;;
    5)
        pactl set-sink-volume @DEFAULT_SINK@ -"${STEP}"
        pactl set-sink-mute @DEFAULT_SINK@ 0
        refresh
        ;;
esac

CURRENT=$(pactl get-default-sink)

OUTPUT=$(get_sink_description "$CURRENT")
OUTPUT=$(short_name "$OUTPUT")

VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk 'NR==1 {print $5}')
MUTED=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')

if [[ "$MUTED" == "yes" ]]; then
    printf "<span foreground='#ff0000'>%s MUTE</span>" "$OUTPUT"
else
    echo "$OUTPUT $VOLUME"
fi