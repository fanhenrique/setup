#!/bin/bash

STATE_FILE="/tmp/polybar-filesystem"

PARTITIONS=(
  "/"
  "/home"
)

get_fs_info() {
  df -hP "$1" 2>/dev/null | awk 'NR==2 {print $3, $2, $5}'
}

# get_swap_info() {
