# i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
command=/usr/share/i3blocks/$BLOCK_NAME
separator_block_width=20
markup=pango

# Date Time
[time]
command=date '+%d/%m/%Y %H:%M'
interval=05

[cpu]
command=~/.config/i3blocks/scripts/cpu
signal=4
interval=1

# [load_average]
# interval=10

# Temperature
#
# Support multiple chips, though lm-sensors.
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[temperature]
label=TEMP
interval=01

#Memory usage
[memory]
command=~/.config/i3blocks/scripts/memory
signal=5
interval=3

# Disk usage
[filesystem]
command=~/.config/i3blocks/scripts/filesystem
signal=6
interval=10

# Network interface monitoring
[network]
command=~/.config/i3blocks/scripts/network
interval=1
signal=7


# Battery indicator
#
# The battery instance defaults to 0.
# [battery]
# label=BAT
# #label=⚡
# #instance=1
# interval=30

# Generic media player support
#
# This displays "ARTIST - SONG" if a music is playing.
# Supported players are: spotify, vlc, audacious, xmms2, mplayer, and others.
#[mediaplayer]
#instance=spotify
#interval=5
#signal=10

# OpenVPN support
#
# Support multiple VPN, with colors.
#[openvpn]
#interval=20

# Volume
[volume]
command=~/.config/i3blocks/scripts/volume
interval=5
signal=10

# Microphone volume
[microphone]
command=~/.config/i3blocks/scripts/microphone
interval=5
signal=11

# Key indicators
#
# Add the following bindings to i3 config file:
#
#bindsym --release Caps_Lock exec pkill -SIGRTMIN+11 i3blocks
#bindsym --release Num_Lock  exec pkill -SIGRTMIN+11 i3blocks
[keyindicator]
command=~/.config/i3blocks/scripts/keyindicator
interval=once
signal=11
